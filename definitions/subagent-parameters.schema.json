{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ultracode.local/schemas/subagent-parameters.schema.json",
  "title": "Ultracode subagent parameter contracts",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "parameters", "agents"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "parameters": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/parameter" }
    },
    "agents": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/agentContract" }
    }
  },
  "$defs": {
    "parameterName": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
    "parameter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["labels", "type"],
      "properties": {
        "labels": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "type": {
          "enum": ["text", "path", "absolute-path", "absolute-directory", "repo-key", "enum"]
        },
        "values": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "description": { "type": "string" }
      },
      "allOf": [
        {
          "if": { "properties": { "type": { "const": "enum" } }, "required": ["type"] },
          "then": { "required": ["values"] }
        }
      ]
    },
    "agentContract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required"],
      "properties": {
        "required": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/parameterName" }
        },
        "oneOf": {
          "type": "array",
          "items": {
            "type": "array",
            "minItems": 2,
            "uniqueItems": true,
            "items": { "$ref": "#/$defs/parameterName" }
          }
        },
        "modes": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "uniqueItems": true,
            "items": { "$ref": "#/$defs/parameterName" }
          }
        }
      }
    }
  }
}
