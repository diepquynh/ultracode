{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${PLUGIN_ROOT}/hooks/session-start.sh\" .codex/ultracode .agents/skills"
          }
        ]
      }
    ],
    "PreToolUse": [
