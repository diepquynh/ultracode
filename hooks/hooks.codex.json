{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/hooks/session-resume.js\""
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Agent|spawn_agent",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/hooks/model-router.js\""
          },
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/hooks/review-cap.js\""
          },
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/hooks/session-guard.js\""
          },
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/hooks/pipeline-gate.js\""
          },
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/hooks/security-block.js\""
          },
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/hooks/spawn-scope.js\""
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/hooks/plugin-guard.js\""
          },
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/hooks/bash-guard.js\""
          },
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/hooks/bash-scope-guard.js\""
          },
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/hooks/build-streak-gate.js\""
          },
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/hooks/skill-init-guard.js\""
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/hooks/plugin-guard.js\""
          },
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/hooks/artifact-guard.js\""
          },
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/hooks/scope-guard.js\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Agent|spawn_agent",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/hooks/spawn-log.js\""
          },
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/hooks/factcheck-record.js\""
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/hooks/build-streak.js\""
          }
        ]
      }
    ]
  }
}
