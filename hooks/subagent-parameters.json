{
  "schemaVersion": 1,
  "parameters": {
    "primary_repo_root": {
      "labels": [
        "Primary repo root"
      ],
      "type": "absolute-directory",
      "description": "Repository that owns this harness session's Ultracode state root."
    },
    "repo_root": {
      "labels": [
        "Repo root"
      ],
      "type": "absolute-directory",
      "description": "Repository whose source, profile, inventory, and skills the subagent operates on."
    },
    "session_dir": {
      "labels": [
        "Session dir"
      ],
      "type": "absolute-path",
      "description": "State/report directory under the primary repository's Ultracode session root."
    },
    "repo_key": {
      "labels": [
        "Repo key"
      ],
      "type": "repo-key",
      "description": "Stable lowercase key used to address this repository's session state."
    },
    "phase": {
      "labels": [
        "Phase"
      ],
      "type": "phase",
      "description": "Review loop this spawn belongs to: the plan phase number, \"{N}-tests\" for that phase's closing test loop, or \"none\" when the work is not tied to a plan phase. Scopes per-loop session state so one loop's iterations are never counted against another's."
    },
    "task": {
      "labels": [
        "Task"
      ],
      "type": "text",
      "description": "Self-contained statement of the work this subagent must perform."
    },
    "mode": {
      "labels": [
        "Mode"
      ],
      "type": "enum",
      "values": [
        "detect",
        "adopt",
        "scout",
        "propose",
        "generate-skill",
        "generate-inventory"
      ]
    },
    "source_harness": {
      "labels": [
        "Source harness"
      ],
      "type": "text"
    },
    "source_runtime_dir": {
      "labels": [
        "Source runtime dir"
      ],
      "type": "path"
    },
    "source_skills_dir": {
      "labels": [
        "Source skills dir"
      ],
      "type": "path"
    },
    "slice": {
      "labels": [
        "Slice"
      ],
      "type": "text"
    },
    "slice_paths": {
      "labels": [
        "Slice paths"
      ],
      "type": "text"
    },
    "stack_reference": {
      "labels": [
        "Stack reference"
      ],
      "type": "path"
    },
    "scout_plan": {
      "labels": [
        "Scout plan"
      ],
      "type": "path"
    },
    "scout_findings": {
      "labels": [
        "Scout findings"
      ],
      "type": "text"
    },
    "skill_name": {
      "labels": [
        "Skill name"
      ],
      "type": "text"
    },
    "skill_kind": {
      "labels": [
        "Skill kind"
      ],
      "type": "text"
    },
    "disposition": {
      "labels": [
        "Disposition"
      ],
      "type": "text"
    },
    "proposal": {
      "labels": [
        "Proposal"
      ],
      "type": "path"
    },
    "generated_skills": {
      "labels": [
        "Generated skills"
      ],
      "type": "text"
    },
    "reused_skills": {
      "labels": [
        "Reused skills"
      ],
      "type": "text"
    },
    "target": {
      "labels": [
        "Target"
      ],
      "type": "path"
    },
    "target_type": {
      "labels": [
        "Target type"
      ],
      "type": "enum",
      "values": [
        "spec",
        "plan"
      ]
    },
    "source_check": {
      "labels": [
        "Source check"
      ],
      "type": "enum",
      "values": [
        "citations",
        "refetch"
      ],
      "description": "How far a fact-check pass goes on external facts. \"citations\" checks that every claim traces to a retrieved page the spec cites. \"refetch\" additionally re-opens those pages, and is valid only on a spec target: the orchestrator decides it per spawn so a plan pass never repeats the check a spec pass already paid for."
    },
    "prior_findings": {
      "labels": [
        "Prior findings"
      ],
      "type": "text",
      "description": "Findings the previous fact-check pass over this same artifact returned, or the literal word \"none\" on a first pass. Decides whether the pass checks the whole claim surface or only the prior findings plus changed text."
    },
    "spec_file": {
      "labels": [
        "Spec file"
      ],
      "type": "path"
    },
    "phase_file": {
      "labels": [
        "Phase file"
      ],
      "type": "path"
    },
    "no_plan": {
      "labels": [
        "No plan"
      ],
      "type": "text"
    },
    "report_file": {
      "labels": [
        "Report file"
      ],
      "type": "absolute-path"
    },
    "implementer_report": {
      "labels": [
        "Implementer report"
      ],
      "type": "path"
    },
    "implementer_reports": {
      "labels": [
        "Implementer reports"
      ],
      "type": "text"
    },
    "epa_report": {
      "labels": [
        "EPA report"
      ],
      "type": "path"
    },
    "changed_files": {
      "labels": [
        "Changed files"
      ],
      "type": "text"
    },
    "change_rationale": {
      "labels": [
        "Change rationale"
      ],
      "type": "text"
    },
    "target_files": {
      "labels": [
        "Target files",
        "Target file"
      ],
      "type": "text"
    },
    "hub_session_key": {
      "labels": [
        "Hub session key"
      ],
      "type": "text",
      "description": "The waiting session's hub session_key, as returned by ultracode_session_register."
    },
    "hub_session_secret": {
      "labels": [
        "Hub session secret"
      ],
      "type": "text",
      "description": "The waiting session's hub session_secret. Consumed only by ultracode:hub-wait, which never echoes it."
    },
    "hub_cursor": {
      "labels": [
        "Hub cursor"
      ],
      "type": "text",
      "description": "The last hub message id the waiting session has already seen (from registration or the previous wait result)."
    },
    "wait_budget": {
      "labels": [
        "Wait budget"
      ],
      "type": "text",
      "description": "How long ultracode:hub-wait keeps waiting before returning timed_out: a whole number of minutes, or \"none\" for as long as the harness allows the spawn to run."
    }
  },
  "agents": {
    "initializer": {
      "required": [
        "primary_repo_root",
        "repo_root",
        "session_dir",
        "repo_key",
        "mode"
      ],
      "modes": {
        "detect": [],
        "adopt": [
          "source_harness",
          "source_runtime_dir",
          "source_skills_dir"
        ],
        "scout": [
          "slice",
          "slice_paths",
          "stack_reference",
          "scout_plan"
        ],
        "propose": [
          "scout_findings",
          "scout_plan"
        ],
        "generate-skill": [
          "skill_name",
          "skill_kind",
          "disposition",
          "proposal",
          "scout_findings"
        ],
        "generate-inventory": [
          "generated_skills",
          "reused_skills",
          "proposal",
          "scout_findings"
        ]
      }
    },
    "explore": {
      "required": [
        "primary_repo_root",
        "repo_root",
        "session_dir",
        "repo_key",
        "task"
      ]
    },
    "generate-spec": {
      "required": [
        "primary_repo_root",
        "repo_root",
        "session_dir",
        "repo_key",
        "task"
      ]
    },
    "fact-check": {
      "required": [
        "primary_repo_root",
        "repo_root",
        "session_dir",
        "repo_key",
        "target",
        "target_type",
        "prior_findings",
        "spec_file",
        "source_check"
      ]
    },
    "plan": {
      "required": [
        "primary_repo_root",
        "repo_root",
        "session_dir",
        "repo_key",
        "spec_file"
      ]
    },
    "implementer": {
      "required": [
        "primary_repo_root",
        "repo_root",
        "session_dir",
        "repo_key",
        "report_file"
      ],
      "oneOf": [
        [
          "phase_file",
          "no_plan"
        ]
      ]
    },
    "execution-path-analyzer": {
      "required": [
        "primary_repo_root",
        "repo_root",
        "session_dir",
        "repo_key",
        "implementer_report",
        "report_file"
      ]
    },
    "write-test": {
      "required": [
        "primary_repo_root",
        "repo_root",
        "session_dir",
        "repo_key",
        "implementer_report",
        "epa_report",
        "report_file"
      ]
    },
    "code-reviewer": {
      "required": [
        "primary_repo_root",
        "repo_root",
        "session_dir",
        "repo_key",
        "phase",
        "changed_files",
        "change_rationale"
      ]
    },
    "prompt-generation": {
      "required": [
        "primary_repo_root",
        "repo_root",
        "session_dir",
        "repo_key",
        "task",
        "target_files"
      ]
    },
    "module-documentation": {
      "required": [
        "primary_repo_root",
        "repo_root",
        "session_dir",
        "repo_key",
        "implementer_reports",
        "report_file"
      ]
    },
    "hub-wait": {
      "required": [
        "primary_repo_root",
        "repo_root",
        "session_dir",
        "repo_key",
        "task",
        "hub_session_key",
        "hub_session_secret",
        "hub_cursor",
        "wait_budget"
      ]
    }
  }
}
